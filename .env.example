POSTGRES_PORT=5432
BACKEND_PORT=8000

# Use these when running the backend directly instead of through Compose.
BLASTSHIELD_ANALYSIS_DATABASE_URL=postgresql+psycopg://blastshield_analyzer:analyzer_demo_password@localhost:5432/blastshield
BLASTSHIELD_APP_DATABASE_URL=postgresql+psycopg://blastshield_app:app_demo_password@localhost:5432/blastshield
BLASTSHIELD_EXECUTION_DATABASE_URL=postgresql+psycopg://blastshield_executor:executor_demo_password@localhost:5432/blastshield
BLASTSHIELD_CORS_ORIGINS=["http://localhost:3000"]
BLASTSHIELD_STATEMENT_TIMEOUT_MS=5000
BLASTSHIELD_LOCK_TIMEOUT_MS=1000
BLASTSHIELD_EXACT_COUNT_MAX_COST=100000
BLASTSHIELD_EXECUTION_STATEMENT_TIMEOUT_MS=10000
BLASTSHIELD_EXECUTION_LOCK_TIMEOUT_MS=2000

# MCP holds only the HTTP API location; it receives no database credentials.
BLASTSHIELD_API_URL=http://localhost:8000
